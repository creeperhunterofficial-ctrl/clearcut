# --- Supabase (required for auth, database, storage) ---
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# --- App ---
# Public site URL (used in callbacks / links)
VITE_SITE_URL=http://localhost:5173

# --- Payments (server-side only — NEVER expose these to the frontend) ---
# Provider: "paytm" or "phonepe" (set when merchant account is approved)
PAYMENT_PROVIDER=
PAYTM_MID=
PAYTM_MERCHANT_KEY=
PHONEPE_MERCHANT_ID=
PHONEPE_SALT_KEY=
PHONEPE_SALT_INDEX=1

# --- Video processing backend (server-side only) ---
PROCESSOR_API_URL=
PROCESSOR_API_KEY=

# --- Admin ---
# Comma-separated user IDs that get the admin role (set after first signup)
ADMIN_USER_IDS=
